# ============================================
# MovoX Corporate — Environment Configuration
# ============================================

# Neon PostgreSQL connection string
# Get this from: https://console.neon.tech/projects → Connection Details
# Format: postgresql://user:pass@ep-xxx.region.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:pass@your-neon-host.neon.tech/neondb?sslmode=require

# JWT signing secret (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Server port (standalone dev only; Vercel ignores this)
PORT=8787

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGIN=https://www.heymovox.com

# ============================================
# Cloudflare R2 (Object Storage)
# ============================================

# R2 bucket endpoint (from Cloudflare Dashboard → R2 → your bucket)
R2_S3_API_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=movox-uploads
R2_PUBLIC_URL=https://cdn.heymovox.com

# R2 API tokens (Cloudflare Dashboard → R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key

# ============================================
# SMTP (Optional — for email notifications)
# ============================================
SMTP_HOST=smtp-rely.com
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password
SMTP_FROM=MovoX <no-reply@heymovox.com>
