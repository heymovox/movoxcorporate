[TEMPLATE]
# Base URL of the enquiry API (see /server). Leave unset to keep the
# Start a Project form in validated demonstration mode.
VITE_API_URL=

# Google Analytics 4 measurement ID (optional)
VITE_GA_MEASUREMENT_ID=

# Force the public site into maintenance mode at build time, even when the
# API is unreachable. Leaving it empty/unset keeps the runtime flag (the
# admin Settings toggle) in charge; changing it requires a rebuild.
VITE_MAINTENANCE=

# --- server/.env (when running the reference backend) ---
# PORT=8787
# ALLOWED_ORIGIN=https://movox.agency
# DATABASE_URL=
# JWT_SECRET=
# Cloudflare R2 upload storage (names only — never commit real values).
# R2_S3_API_URL must be the bare S3 endpoint WITHOUT the bucket in the path.
# R2_ACCOUNT_ID=
# R2_S3_API_URL=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
# Outbound staff email over SMTP (account credentials, role-change notices).
# Any provider works: the company mailbox, Resend (smtp.resend.com:465),
# SendGrid (smtp.sendgrid.net:587), Postmark. Left unset, emails are skipped
# and the dashboard shows the generated password to the admin once instead.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="MovoX <no-reply@heymovox.com>"
