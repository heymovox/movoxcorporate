{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "devCommand": "npm run dev",
      "routes": [
        { "handle": "filesystem" },
        { "source": "/(.*)", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/assets/(.*)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
          ]
        },
        {
          "source": "/(.*)",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
          ]
        }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "index.ts",
      "devCommand": "npm run dev"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "api.heymovox.com" }],
      "destination": { "service": "server" }
    },
    {
      "source": "/api/(.*)",
      "has": [{ "type": "host", "value": "admin.heymovox.com" }],
      "destination": { "service": "server" }
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "admin.heymovox.com" }],
      "destination": { "service": "app" }
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "portal.heymovox.com" }],
      "destination": { "service": "app" }
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "secure.heymovox.com" }],
      "destination": { "service": "app" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}